      "insert_after": "amended_from",
      "label": "Slack Attendance Reply TS",
      "no_copy": 1,
      "print_hide": 1,
      "read_only": 1,
      "report_hide": 1
    },
    {
      "description": "Slack reference of the applicant's leave DM, kept so the message can be updated in place.",
      "fieldname": "custom_slack_applicant_channel",
      "fieldtype": "Data",
      "hidden": 1,
      "insert_after": "leave_approver_name",
      "label": "Slack Applicant Channel",

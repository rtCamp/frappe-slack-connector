      "no_copy": 1,
      "read_only": 1
    },
    {
      "fieldname": "custom_slack_attendance_reply_channel",
      "fieldtype": "Data",
      "hidden": 1,
      "insert_after": "custom_slack_attendance_reply_ts",
      "label": "Slack Attendance Reply Channel",
      "no_copy": 1,
      "print_hide": 1,
      "read_only": 1,
      "report_hide": 1
    },
    {
      "fieldname": "custom_slack_attendance_reply_text",
      "fieldtype": "Small Text",
      "hidden": 1,
      "insert_after": "custom_slack_attendance_reply_channel",
      "label": "Slack Attendance Reply Text",

    {
      "fieldname": "custom_slack_userid",
      "fieldtype": "Data",
      "insert_after": "custom_slack_information",
      "label": "Slack UserID",
      "read_only": 1,
      "translatable": 1
    },
    {
      "fieldname": "custom_slack_username",
      "fieldtype": "Data",
      "insert_after": "custom_slack_userid",
      "label": "Slack Username",
      "read_only": 1,
      "translatable": 1
    }
  ],
  "Leave Application": [
